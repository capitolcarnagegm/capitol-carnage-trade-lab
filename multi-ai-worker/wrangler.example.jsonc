{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gms-locker-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gms-locker-db",
      "database_id": "4d3b93c6-25cf-42cc-9458-8fe6deb20c17",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *", "2,17,32,47 * * * *"]
  },
  "vars": {
    "APP_ENV": "production",
    "GM_VALUE_HORIZON_YEARS": "5",
    "GM_MIN_ACCEPTABLE_SCORE": "87",
    "GM_MAX_CONTRACT_YEARS": "5",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "LLAMA_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "GEMINI_DAILY_REQUEST_LIMIT": "45",
    "FANTRAX_LEAGUE_ID": "astbqxhwmk4b6bg9",
    "LLAMA_DAILY_NEURON_LIMIT": "7500"
  }
}
